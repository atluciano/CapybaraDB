{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-vcpkg",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_EXTENSIONS": "OFF"
      },
      "environment": {
        "VCPKG_KEEP_ENV_VARS": "Qt6_DIR;CMAKE_PREFIX_PATH;QT_ROOT_DIR"
      }
    },
    {
      "name": "win-msvc-debug",
      "displayName": "Windows x64 MSVC Debug",
      "inherits": "base-vcpkg",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "win-msvc-release",
      "displayName": "Windows x64 MSVC Release",
      "inherits": "base-vcpkg",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux x64 GCC Debug (ASan + UBSan)",
      "inherits": "base-vcpkg",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CAPYBARADB_ENABLE_SANITIZERS": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux x64 GCC Release",
      "inherits": "base-vcpkg",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux x64 Clang Release",
      "inherits": "base-vcpkg",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-msvc-debug",
      "configurePreset": "win-msvc-debug"
    },
    {
      "name": "win-msvc-release",
      "configurePreset": "win-msvc-release"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug"
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release"
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang-release"
    }
  ],
  "testPresets": [
    {
      "name": "win-msvc-debug",
      "configurePreset": "win-msvc-debug",
      "output": { "outputOnFailure": true },
      "environment": { "QT_QPA_PLATFORM": "offscreen" }
    },
    {
      "name": "win-msvc-release",
      "configurePreset": "win-msvc-release",
      "output": { "outputOnFailure": true },
      "environment": { "QT_QPA_PLATFORM": "offscreen" }
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug",
      "output": { "outputOnFailure": true },
      "environment": { "QT_QPA_PLATFORM": "offscreen" }
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release",
      "output": { "outputOnFailure": true },
      "environment": { "QT_QPA_PLATFORM": "offscreen" }
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang-release",
      "output": { "outputOnFailure": true },
      "environment": { "QT_QPA_PLATFORM": "offscreen" }
    }
  ]
}
